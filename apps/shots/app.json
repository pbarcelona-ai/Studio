{
  "$schema": "../../schema/app.schema.json",
  "id": "shots",
  "name": "Shots",
  "section": "image",
  "summary": "Nine framings of one image: wide, close-up, top-down, low angle and rotations.",
  "higgsfield_feature": "Shots",
  "pack": "image-qwen-edit",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_qwen_image_edit_2509_relight.json",
    "comfyui": "0.42.0",
    "notes": "Template app written by tools/template_apps.py: the workflow is apps/relight's (built by tools/build_apps.py) with \u955c\u5934\u8f6c\u6362.safetensors in place of the Relight LoRA and no Relight trigger; the prompt below is fixed and \"Extra direction\" is appended to it."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Your photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "shot",
      "type": "select",
      "label": "Shot",
      "default": "\u5c06\u955c\u5934\u8f6c\u4e3a\u5e7f\u89d2\u955c\u5934 Turn the camera to a wide-angle lens.",
      "options": [
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u5e7f\u89d2\u955c\u5934 Turn the camera to a wide-angle lens.",
          "label": "Wide-angle"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u7279\u5199\u955c\u5934 Turn the camera to a close-up.",
          "label": "Close-up"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u6781\u7279\u5199\u955c\u5934 Turn the camera to an extreme close-up.",
          "label": "Extreme close-up"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u4fef\u89c6 Turn the camera to a top-down view.",
          "label": "Top-down"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u4ef0\u89c6 Turn the camera to a low-angle view looking up.",
          "label": "Low angle"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u5de6\u65cb\u8f6c45\u5ea6 Rotate the camera 45 degrees to the left.",
          "label": "Rotate 45\u00b0 left"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u53f3\u65cb\u8f6c45\u5ea6 Rotate the camera 45 degrees to the right.",
          "label": "Rotate 45\u00b0 right"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u5de6\u65cb\u8f6c90\u5ea6 Rotate the camera 90 degrees to the left.",
          "label": "Rotate 90\u00b0 left"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u5230\u4eba\u7269\u80cc\u540e Move the camera behind the subject.",
          "label": "From behind"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "default": "",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "15",
          "field": "value",
          "template": "{shot} {details}"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "10:3",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "12",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
      "file": "split_files/diffusion_models/qwen_image_edit_2509_fp8_e4m3fn.safetensors",
      "dir": "diffusion_models",
      "gb": 20.43,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image_ComfyUI",
      "file": "split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "dir": "text_encoders",
      "gb": 9.38,
      "phase": "encode",
      "license": "Apache-2.0"
    },
    {
      "repo": "Comfy-Org/Qwen-Image_ComfyUI",
      "file": "split_files/vae/qwen_image_vae.safetensors",
      "dir": "vae",
      "gb": 0.25,
      "phase": "decode",
      "license": "Apache-2.0"
    },
    {
      "repo": "lightx2v/Qwen-Image-Lightning",
      "file": "Qwen-Image-Edit-2509/Qwen-Image-Edit-2509-Lightning-4steps-V1.0-bf16.safetensors",
      "dir": "loras",
      "gb": 0.85,
      "phase": "denoise",
      "license": "Apache-2.0"
    },
    {
      "repo": "dx8152/Qwen-Edit-2509-Multiple-angles",
      "file": "\u955c\u5934\u8f6c\u6362.safetensors",
      "dir": "loras",
      "gb": 0.24,
      "phase": "denoise",
      "license": "Apache-2.0"
    }
  ],
  "credits": [
    "Qwen-Image-Edit-2509 by Alibaba Qwen (Apache-2.0)",
    "Multiple Angles LoRA by dx8152 (Apache-2.0)",
    "Lightning LoRA by lightx2v",
    "Workflow: ComfyUI official template"
  ],
  "test": {
    "image": "test/portrait.png",
    "shot": "\u5c06\u955c\u5934\u8f6c\u4e3a\u7279\u5199\u955c\u5934 Turn the camera to a close-up."
  },
  "min_vram_gb": 21.52,
  "platforms": [
    "win_cuda",
    "linux_cuda"
  ]
}
