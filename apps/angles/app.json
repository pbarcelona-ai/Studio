{
  "$schema": "../../schema/app.schema.json",
  "id": "angles",
  "name": "Angles",
  "section": "image",
  "summary": "The same scene from another camera position: move, rotate, look down (Multiple Angles LoRA on Qwen-Image-Edit).",
  "higgsfield_feature": "Angles 2.0",
  "pack": "image-qwen-edit",
  "status": "ready",
  "workflow": "workflow.api.json",
  "source": {
    "template": "image_qwen_image_edit_2509_relight.json",
    "comfyui": "0.42.0",
    "notes": "Template app written by tools/template_apps.py: the workflow is apps/relight's (built by tools/build_apps.py) with \u955c\u5934\u8f6c\u6362.safetensors in place of the Relight LoRA and no Relight trigger; the prompt below is fixed and \"Extra direction\" is appended to it."
  },
  "inputs": [
    {
      "id": "image",
      "type": "image",
      "label": "Your photo",
      "required": true,
      "limits": {
        "max_mb": 20
      },
      "bind": [
        {
          "node": "11",
          "field": "image"
        }
      ]
    },
    {
      "id": "move",
      "type": "select",
      "label": "Camera move",
      "default": "\u5c06\u955c\u5934\u5411\u5de6\u65cb\u8f6c45\u5ea6 Rotate the camera 45 degrees to the left.",
      "options": [
        {
          "value": "\u5c06\u955c\u5934\u5411\u524d\u79fb\u52a8 Move the camera forward.",
          "label": "Move forward"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u540e\u79fb\u52a8 Move the camera backward.",
          "label": "Move back"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u5de6\u79fb\u52a8 Move the camera left.",
          "label": "Move left"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u53f3\u79fb\u52a8 Move the camera right.",
          "label": "Move right"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u4e0a\u79fb\u52a8 Move the camera up.",
          "label": "Move up"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u4e0b\u79fb\u52a8 Move the camera down.",
          "label": "Move down"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u5de6\u65cb\u8f6c45\u5ea6 Rotate the camera 45 degrees to the left.",
          "label": "Rotate 45\u00b0 left"
        },
        {
          "value": "\u5c06\u955c\u5934\u5411\u53f3\u65cb\u8f6c45\u5ea6 Rotate the camera 45 degrees to the right.",
          "label": "Rotate 45\u00b0 right"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u4fef\u89c6 Turn the camera to a top-down view.",
          "label": "Top-down view"
        },
        {
          "value": "\u5c06\u955c\u5934\u8f6c\u4e3a\u4ef0\u89c6 Turn the camera to a low-angle view looking up.",
          "label": "Low angle"
        }
      ]
    },
    {
      "id": "details",
      "type": "textarea",
      "label": "Extra direction",
      "default": "",
      "help": "Added at the end of the app's prompt.",
      "bind": [
        {
          "node": "15",
          "field": "value",
          "template": "{move} {details}"
        }
      ]
    },
    {
      "id": "seed",
      "type": "seed",
      "label": "Seed",
      "default": -1,
      "help": "-1 picks a random seed",
      "bind": [
        {
          "node": "10:3",
          "field": "seed"
        }
      ]
    }
  ],
  "outputs": [
    {
      "node": "12",
      "type": "image",
      "label": "Result"
    }
  ],
  "models": [
    {
      "repo": "Comfy-Org/Qwen-Image-Edit_ComfyUI",
